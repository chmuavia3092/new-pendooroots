---
// HeroGrainient — Grainient WebGL gradient (PENDOOROOTS green theme)
---

<div class="hero-grainient" id="heroGrainient" aria-hidden="true"></div>

<script is:inline src="/scripts/grainient-pendooroots.js"></script>

<style>
  .hero-grainient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
  }
  .hero-grainient :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-grainient :global(canvas) { display: none; }
  }
</style>
