---
// HeroGrainient — WebGL animated gradient background
---

<div class="hero-grainient" id="heroGrainient" data-grainient aria-hidden="true"></div>

<script>
  import { initGrainient } from './HeroGrainient';
  
  const container = document.getElementById('heroGrainient');
  if (container) {
    initGrainient(container);
  }
</script>

<style>
  .hero-grainient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
  }

  .hero-grainient :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grainient :global(canvas) {
      display: none;
    }
  }
</style>
