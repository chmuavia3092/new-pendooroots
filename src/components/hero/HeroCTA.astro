---
import SpecularButton from '@/components/ui/SpecularButton';

interface Props {
  cta1: string;
  cta2: string;
  class?: string;
}

const { cta1, cta2, class: className = '' } = Astro.props;
---

<div class={`hero-actions ${className}`}>
  <SpecularButton client:load size="lg" lineColor="#ccff00" baseColor="#000000" textColor="#ffffff">
    {cta1} <i class="fas fa-arrow-right" aria-hidden="true"></i>
  </SpecularButton>

  <SpecularButton client:load size="lg" lineColor="#ccff00" baseColor="#000000" textColor="#ffffff">
    {cta2} <i class="fas fa-play" aria-hidden="true"></i>
  </SpecularButton>
</div>

<style>
  .hero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 64px;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .hero-actions { justify-content: center; }
  }

  @media (max-width: 768px) {
    .hero-actions {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
