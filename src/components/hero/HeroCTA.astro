---
interface Props {
  cta1: string;
  cta2: string;
  class?: string;
}

const { cta1, cta2, class: className = '' } = Astro.props;
---

<div class="hero-actions {className}">
  <a href="/shop" class="btn btn-primary btn-lg"
     data-border-glow
     data-glow-color="120 100 50"
     data-background-color="#004b1c"
     data-border-radius="999"
     data-glow-radius="30"
     data-glow-intensity="1"
     data-cone-spread="25"
     data-colors="#ccff00,#4caf50,#2e7d32">
    {cta1} <i class="fas fa-arrow-right" aria-hidden="true"></i>
  </a>

  <a href="/shop/lemoo-washer" class="btn btn-outline btn-lg"
     data-border-glow
     data-glow-color="120 100 50"
     data-background-color="transparent"
     data-border-radius="999"
     data-glow-radius="30"
     data-glow-intensity="0.8"
     data-cone-spread="25"
     data-colors="#ccff00,#4caf50,#2e7d32">
    {cta2} <i class="fas fa-play" aria-hidden="true"></i>
  </a>
</div>

<style>
  .hero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 64px;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .hero-actions { justify-content: center; }
  }

  @media (max-width: 768px) {
    .hero-actions {
      flex-direction: column;
      align-items: center;
    }
    .hero-actions .star-border-container,
    .hero-actions .hero-btn-secondary {
      width: 100%;
      max-width: 280px;
    }
  }
</style>