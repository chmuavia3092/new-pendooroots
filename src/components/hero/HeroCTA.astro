---
interface Props {
  cta1: string;
  cta2: string;
  class?: string;
}

const { cta1, cta2, class: className = '' } = Astro.props;
---

<div class={`hero-actions ${className}`}>
  <a href="/shop" class="cta-btn cta-btn--primary">
    {cta1} <i class="fas fa-arrow-right" aria-hidden="true"></i>
  </a>

  <a href="/shop/lemoo-washer" class="cta-btn cta-btn--secondary">
    {cta2} <i class="fas fa-play" aria-hidden="true"></i>
  </a>
</div>

<style>
  .hero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 64px;
    flex-wrap: wrap;
  }

  .cta-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 18px 38px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1.125rem;
    text-decoration: none;
    color: #fff;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease;
    will-change: transform;
  }

  .cta-btn--primary {
    background: #000;
    box-shadow: 0 0 0 1.5px rgba(204, 255, 0, 0.55), 0 0 18px rgba(204, 255, 0, 0.28), 0 10px 24px -14px rgba(0, 0, 0, 0.45);
  }

  .cta-btn--secondary {
    background: #000;
    box-shadow: 0 0 0 1.5px rgba(204, 255, 0, 0.4), 0 0 14px rgba(76, 175, 80, 0.22), 0 10px 24px -14px rgba(0, 0, 0, 0.45);
  }

  .cta-btn::after {
    content: '';
    position: absolute;
    inset: -40%;
    background: linear-gradient(115deg, transparent 42%, rgba(204, 255, 0, 0.18) 50%, transparent 58%);
    background-size: 260% 100%;
    background-position: 130% 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .cta-btn:hover {
    transform: scale(1.03);
  }

  .cta-btn--primary:hover {
    box-shadow: 0 0 0 2px rgba(204, 255, 0, 0.85), 0 0 28px rgba(204, 255, 0, 0.5), 0 10px 24px -14px rgba(0, 0, 0, 0.45);
  }

  .cta-btn--secondary:hover {
    box-shadow: 0 0 0 2px rgba(204, 255, 0, 0.6), 0 0 22px rgba(76, 175, 80, 0.4), 0 10px 24px -14px rgba(0, 0, 0, 0.45);
  }

  .cta-btn:hover::after {
    opacity: 1;
    animation: cta-sweep 1.1s linear infinite;
  }

  @keyframes cta-sweep {
    from { background-position: 130% 0; }
    to { background-position: -130% 0; }
  }

  .cta-btn:active {
    transform: scale(0.97);
  }

  .cta-btn:focus-visible {
    outline: 2px solid rgba(204, 255, 0, 0.55);
    outline-offset: 3px;
  }

  @media (max-width: 1024px) {
    .hero-actions { justify-content: center; }
  }

  @media (max-width: 768px) {
    .hero-actions {
      flex-direction: column;
      align-items: center;
    }
    .cta-btn {
      width: 100%;
      max-width: 280px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-btn:hover::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
