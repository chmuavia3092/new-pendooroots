---
import type { HeroContent } from '@/data/content';
import HeroBottle from './HeroBottle.astro';
import HeroStats from './HeroStats.astro';
import HeroCTA from './HeroCTA.astro';

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-gradient" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="hero-grid">
      <div class="hero-left">
        <div class="hero-tag reveal">
          <i class="fas fa-leaf" aria-hidden="true"></i>
          <span>{content.tag}</span>
        </div>

        <h1 id="hero-title" class="hero-title reveal reveal-delay-1">
          {content.headline1}<br>
          {content.headline2} <span class="accent">{content.headlineAccent}</span>
        </h1>

        <p class="hero-subtitle reveal reveal-delay-2">
          {content.subtitle}
        </p>

        <HeroCTA
          cta1={content.cta1}
          cta2={content.cta2}
          class="reveal reveal-delay-3"
        />

        <HeroStats
          stats={content.stats}
          class="reveal reveal-delay-4"
        />
      </div>

      <div class="hero-right">
        <div class="hero-product-showcase">
          <HeroBottle />
        </div>
      </div>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #002e11;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #002e11 0%, #004b1c 40%, #006b2a 70%, #004b1c 100%);
    z-index: 0;
  }

  .hero-gradient::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 70% 40%, rgba(76, 175, 80, 0.25), transparent),
      radial-gradient(ellipse 60% 80% at 30% 60%, rgba(204, 255, 0, 0.08), transparent);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 120px 32px 80px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(204, 255, 0, 0.1);
    border: 1px solid rgba(204, 255, 0, 0.3);
    color: #ccff00;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    width: fit-content;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    color: #ffffff;
    margin: 0;
  }

  .hero-title .accent {
    color: #ccff00;
    font-family: 'Playfair Display', serif;
    font-style: italic;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    max-width: 480px;
    margin: 0;
  }

  .hero-right {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-product-showcase {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-scroll {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 1;
  }

  .hero-scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.5), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-tag { margin: 0 auto; }
    .hero-subtitle { margin: 0 auto; }
    .hero-right { order: -1; }
    .hero-product-showcase { max-width: 300px; }
  }

  @media (max-width: 768px) {
    .hero-content { padding: 100px 20px 60px; }
    .hero-title { font-size: 2.2rem; }
    .hero-subtitle { font-size: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line { animation: none; }
  }
</style>
