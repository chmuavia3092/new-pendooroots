---
import type { HeroContent } from '@/data/content';
import HeroBottle from './HeroBottle.astro';
import HeroGrainient from './HeroGrainient.astro';
import HeroStats from './HeroStats.astro';
import HeroCTA from './HeroCTA.astro';

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <HeroGrainient />

  <div class="hero-content">
    <div class="hero-grid">
      <div class="hero-left">
        <div class="hero-tag reveal">
          <i class="fas fa-leaf" aria-hidden="true"></i>
          <span>{content.tag}</span>
        </div>

        <h1 id="hero-title" class="hero-title reveal reveal-delay-1">
          {content.headline1}<br>
          {content.headline2} <span class="accent">{content.headlineAccent}</span>
        </h1>

        <p class="hero-subtitle reveal reveal-delay-2">
          {content.subtitle}
        </p>

        <HeroCTA
          cta1={content.cta1}
          cta2={content.cta2}
          class="reveal reveal-delay-3"
        />

        <HeroStats
          stats={content.stats}
          class="reveal reveal-delay-4"
        />
      </div>

      <div class="hero-right">
        <div class="hero-product-showcase">
          <HeroBottle />
        </div>
      </div>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 60% at 10% 20%, #b8e600 0%, transparent 50%),
      radial-gradient(ellipse 60% 50% at 30% 50%, #4caf50 0%, transparent 60%),
      radial-gradient(ellipse 50% 50% at 70% 40%, #2e7d32 0%, transparent 50%),
      radial-gradient(ellipse 60% 60% at 90% 80%, #1b5e20 0%, transparent 60%),
      linear-gradient(135deg, #ccff00 0%, #4caf50 25%, #2e7d32 50%, #1b5e20 75%, #002e11 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 140px 0 100px;
  }

  .hero-grid {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .hero-left {
    max-width: 620px;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 20px;
    background: rgba(204, 255, 0, 0.1);
    border: 1px solid rgba(204, 255, 0, 0.2);
    border-radius: var(--radius-full);
    color: #ccff00;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin-bottom: 32px;
    backdrop-filter: blur(10px);
  }

  .hero-tag i {
    font-size: 0.7rem;
  }

  .hero-title {
    font-family: var(--font-family-display);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 500;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: var(--tracking-tight);
  }

  .hero-title .accent {
    color: #ccff00;
    font-family: var(--font-family-script);
    font-style: normal;
    font-size: 1.15em;
    line-height: 1;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    margin-bottom: 48px;
    max-width: 480px;
    font-weight: 300;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 64px;
    flex-wrap: wrap;
  }

  .hero-stats {
    display: flex;
    gap: 48px;
  }

  .hero-stat {
    text-align: left;
  }

  .hero-stat-value {
    font-size: 2rem;
    font-weight: var(--font-weight-extrabold);
    color: #fff;
    line-height: 1;
    margin-bottom: 4px;
    font-variant-numeric: tabular-nums;
  }

  .hero-stat-label {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
  }

  .hero-right {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-product-showcase {
    position: relative;
    width: 100%;
    max-width: 480px;
  }

  .hero-scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.7rem;
    letter-spacing: var(--tracking-widest-plus);
    text-transform: uppercase;
    z-index: 2;
  }

  .hero-scroll-line {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.15);
    position: relative;
    overflow: hidden;
  }

  .hero-scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: #ccff00;
    animation: scrollLine 2s ease-in-out infinite;
  }

  @keyframes scrollLine {
    0% { top: -100%; }
    100% { top: 100%; }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 60px;
      text-align: center;
    }
    .hero-left { max-width: 100%; }
    .hero-actions { justify-content: center; }
    .hero-stats { justify-content: center; gap: 32px; }
    .hero-right { order: -1; }
    .hero-product-showcase { max-width: 400px; }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 100px 0 80px;
      background:
        radial-gradient(ellipse 80% 60% at 20% 10%, #b8e600 0%, transparent 50%),
        radial-gradient(ellipse 60% 50% at 50% 50%, #4caf50 0%, transparent 60%),
        radial-gradient(ellipse 60% 60% at 80% 90%, #1b5e20 0%, transparent 60%),
        linear-gradient(135deg, #ccff00 0%, #4caf50 30%, #2e7d32 60%, #1b5e20 85%, #002e11 100%);
    }
    .hero-content { padding: 80px 0 60px; }
    .hero-title { font-size: clamp(2.5rem, 8vw, 3.5rem); }
    .hero-subtitle { font-size: 1rem; max-width: 100%; }
    .hero-stats { flex-wrap: wrap; gap: 24px; }
    .hero-stats { justify-content: center; }
    .hero-stat { text-align: center; }
    .hero-stat-value { font-size: 1.75rem; }
    .hero-product-showcase { max-width: 320px; }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line::after {
      animation: none !important;
    }
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>
