---
// HeroBottle â€” Pure CSS 3D float animation (no client hydration needed)
// Glow pulses via opacity (GPU-cheap); only `transform` is continuously animated.
---

<div class="hero-bottle-wrapper">
  <img
    src="/images/lemoo-washer-family-pack.webp"
    alt="LEMOO Washer dish wash bottle â€” Make Every Dish Shine"
    width="800"
    height="800"
    loading="eager"
    fetchpriority="high"
    class="hero-bottle"
    decoding="async"
  />
</div>

<style>
  .hero-bottle-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-style: preserve-3d;
    perspective: 1000px;
  }

  /* Soft lime halo behind the bottle â€” pulses on opacity only (cheap) */
  .hero-bottle-wrapper::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 340px;
    height: 340px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(204, 255, 0, 0.22) 0%, transparent 70%);
    filter: blur(30px);
    z-index: -1;
    animation: heroGlow 5s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-bottle {
    width: auto;
    height: 500px;
    max-width: 100%;
    object-fit: contain;
    border-radius: var(--radius-xl);
    animation: heroFloatRotate 9s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.4));
    transform-style: preserve-3d;
    will-change: transform;
  }

  @keyframes heroFloatRotate {
    0%   { transform: translateY(0px)    rotateY(0deg)   rotateX(0deg)   scale(1); }
    15%  { transform: translateY(-16px)  rotateY(8deg)   rotateX(3deg)   scale(1.02); }
    30%  { transform: translateY(-7px)   rotateY(-5deg)  rotateX(-2deg)  scale(0.99); }
    50%  { transform: translateY(-22px)  rotateY(12deg)  rotateX(4deg)   scale(1.03); }
    70%  { transform: translateY(-11px)  rotateY(-8deg)  rotateX(-3deg)  scale(1.01); }
    85%  { transform: translateY(-18px)  rotateY(5deg)   rotateX(2deg)   scale(1.02); }
    100% { transform: translateY(0px)    rotateY(0deg)   rotateX(0deg)   scale(1); }
  }

  @keyframes heroGlow {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 1; }
  }

  @media (max-width: 1024px) {
    .hero-bottle { max-width: 480px; }
    .hero-bottle-wrapper::before { width: 300px; height: 300px; }
  }

  @media (max-width: 768px) {
    .hero-bottle { max-width: 360px; height: 420px; }
    .hero-bottle-wrapper::before { width: 240px; height: 240px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bottle {
      animation: none !important;
      filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.4));
    }
    .hero-bottle-wrapper::before {
      animation: none !important;
      opacity: 0.75;
    }
  }
</style>


