---
import type { Product } from '@/data/products';
import { formatPrice } from '@/data/products';
import BorderBeam from '@/components/ui/BorderBeam.astro';

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;
---

<article class:list={['product-card', 'reveal', `reveal-delay-${Math.min(index + 1, 4)}`]} data-product-id={product.id}>
  <a href={`/shop/${product.slug}`} class="product-card-link" aria-label={`View ${product.name} ${product.variant}`}>
    {product.badge ? (
      <BorderBeam duration={6} size={100} colorFrom="#ccff00" colorTo="#4caf50" class="border-beam-active">
        <div class="product-card-image">
          <img src={product.image} alt={`${product.name} ${product.variant}`} width="400" height="400" loading="lazy" decoding="async" />
          <span class="product-badge">{product.badge}</span>
          <div class="product-card-actions">
            <button class="product-action-btn" data-wishlist-toggle={product.id} aria-label="Add to wishlist">
              <i class="fas fa-heart" aria-hidden="true"></i>
            </button>
            <button class="product-action-btn" data-quick-view={product.id} aria-label="Quick view">
              <i class="fas fa-eye" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </BorderBeam>
    ) : (
      <div class="product-card-image">
        <img src={product.image} alt={`${product.name} ${product.variant}`} width="400" height="400" loading="lazy" decoding="async" />
        <div class="product-card-actions">
          <button class="product-action-btn" data-wishlist-toggle={product.id} aria-label="Add to wishlist">
            <i class="fas fa-heart" aria-hidden="true"></i>
          </button>
          <button class="product-action-btn" data-quick-view={product.id} aria-label="Quick view">
            <i class="fas fa-eye" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    )}
    <div class="product-card-body">
      <div class="product-card-meta">
        <span class="product-card-category">{product.collection}</span>
        <div class="product-card-rating">
          <span class="stars">{'★'.repeat(Math.round(product.rating))}{'☆'.repeat(5 - Math.round(product.rating))}</span>
          <span class="review-count">({product.reviews})</span>
        </div>
      </div>
      <h3 class="product-card-name">{product.name}</h3>
      <p class="product-card-variant">{product.variant}</p>
      <div class="product-card-price">
        <span class="price-current">{formatPrice(product.price)}</span>
        {product.oldPrice && <span class="price-old">{formatPrice(product.oldPrice)}</span>}
      </div>
    </div>
  </a>
</article>

<style>
  .product-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: var(--transition-base);
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }

  .product-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .product-card-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .product-card:hover .product-card-image img {
    transform: scale(1.06);
  }

  .product-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 6px 14px;
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    border-radius: var(--radius-full);
    z-index: 2;
  }

  .product-card-actions {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: 0;
    transform: translateX(12px);
    transition: var(--transition-base);
    z-index: 2;
  }

  .product-card:hover .product-card-actions {
    opacity: 1;
    transform: translateX(0);
  }

  .product-action-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-fast);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .product-action-btn:hover {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }

  .product-card-body {
    padding: 20px;
  }

  .product-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .product-card-category {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .product-card-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .stars {
    color: var(--color-star);
  }

  .product-card-name {
    font-family: var(--font-family-display);
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .product-card-variant {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: 12px;
  }

  .product-card-price {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .price-current {
    font-size: 1.1rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .price-old {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: line-through;
  }
</style>
