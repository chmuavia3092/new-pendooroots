---
import type { Product } from '@/data/products';
import { formatPrice } from '@/data/products';
import BorderBeam from '@/components/ui/BorderBeam.astro';

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;
---

<article class:list={['product-card', 'reveal', `reveal-delay-${Math.min(index + 1, 4)}`]} data-product-id={product.id}>
  <a href={`/shop/${product.slug}`} class="product-card-link" aria-label={`View ${product.name} ${product.variant}`}>
    {product.badge ? (
      <BorderBeam duration={6} size={100} colorFrom="#ccff00" colorTo="#4caf50" class="border-beam-active">
        <div class="product-card-image">
          <img src={product.image} alt={`${product.name} ${product.variant}`} width="400" height="400" loading="lazy" decoding="async" />
          <span class="product-badge">{product.badge}</span>
          <div class="product-card-actions">
            <button class="product-action-btn" data-wishlist-toggle={product.id} aria-label="Add to wishlist">
              <i class="fas fa-heart" aria-hidden="true"></i>
            </button>
            <button class="product-action-btn" data-quick-view={product.id} aria-label="Quick view">
              <i class="fas fa-eye" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </BorderBeam>
    ) : (
      <div class="product-card-image">
        <img src={product.image} alt={`${product.name} ${product.variant}`} width="400" height="400" loading="lazy" decoding="async" />
        <div class="product-card-actions">
          <button class="product-action-btn" data-wishlist-toggle={product.id} aria-label="Add to wishlist">
            <i class="fas fa-heart" aria-hidden="true"></i>
          </button>
          <button class="product-action-btn" data-quick-view={product.id} aria-label="Quick view">
            <i class="fas fa-eye" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    )}
    <div class="product-card-body">
      <div class="product-card-meta">
        <span class="product-card-category">{product.collection}</span>
        <div class="product-card-rating">
          <span class="stars">{'★'.repeat(Math.round(product.rating))}{'☆'.repeat(5 - Math.round(product.rating))}</span>
          <span class="review-count">({product.reviews})</span>
        </div>
      </div>
      <h3 class="product-card-name">{product.name}</h3>
      <p class="product-card-variant">{product.variant}</p>
      <div class="product-card-price">
        <span class="price-current">{formatPrice(product.price)}</span>
        {product.oldPrice && <span class="price-old">{formatPrice(product.oldPrice)}</span>}
      </div>
    </div>
  </a>
</article>
