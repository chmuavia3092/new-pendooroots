---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Journal — PENDOOROOTS" description="Stories, tips, and insights from our botanical world.">
  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="container">
      <h1 class="page-hero-title">Our <span class="accent">Journal</span></h1>
      <p class="page-hero-desc">Stories from our botanical world</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="journal-grid">
        <article class="journal-card reveal reveal-delay-1">
          <div class="journal-image">
            <img src="/images/lemoo-washer.png" alt="The Art of Natural Cleaning" width="600" height="400" loading="lazy">
            <div class="journal-date">Jan 15, 2024</div>
          </div>
          <div class="journal-body">
            <div class="journal-tag"><i class="fas fa-leaf"></i> Cleaning</div>
            <h2 class="journal-title">The Art of Natural Cleaning</h2>
            <p class="journal-excerpt">Discover how botanical ingredients can transform your daily cleaning routine into a luxurious, health-conscious ritual.</p>
            <a href="#" class="journal-link">Read More <i class="fas fa-arrow-right"></i></a>
          </div>
        </article>
        <article class="journal-card reveal reveal-delay-2">
          <div class="journal-image">
            <img src="/images/lemoo-washer.png" alt="Behind Our Ingredients" width="600" height="400" loading="lazy">
            <div class="journal-date">Feb 3, 2024</div>
          </div>
          <div class="journal-body">
            <div class="journal-tag"><i class="fas fa-flask"></i> Ingredients</div>
            <h2 class="journal-title">Behind Our Ingredients</h2>
            <p class="journal-excerpt">A deep dive into the sourcing, science, and sustainability behind every ingredient in our formulations.</p>
            <a href="#" class="journal-link">Read More <i class="fas fa-arrow-right"></i></a>
          </div>
        </article>
        <article class="journal-card reveal reveal-delay-3">
          <div class="journal-image">
            <img src="/images/lemoo-washer.png" alt="Sustainable Living Tips" width="600" height="400" loading="lazy">
            <div class="journal-date">Mar 20, 2024</div>
          </div>
          <div class="journal-body">
            <div class="journal-tag"><i class="fas fa-recycle"></i> Lifestyle</div>
            <h2 class="journal-title">Sustainable Living Tips</h2>
            <p class="journal-excerpt">Small changes that make a big difference. Practical ways to reduce waste and live more consciously.</p>
            <a href="#" class="journal-link">Read More <i class="fas fa-arrow-right"></i></a>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 160px 0 80px; position: relative; overflow: hidden;
    background: linear-gradient(135deg, #003513 0%, #004b1c 40%, #006b2a 70%, #1a8a4a 100%);
  }
  .page-hero-bg {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 50% at 20% 80%, rgba(204,255,0,0.12) 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 80% 20%, rgba(204,255,0,0.08) 0%, transparent 50%);
  }
  .page-hero-title {
    font-family: var(--font-family-script); font-size: clamp(2.5rem, 5vw, 4rem);
    color: #fff; font-weight: 400; line-height: 1.2; position: relative; z-index: 1;
  }
  .page-hero-title .accent { color: var(--color-accent); font-family: var(--font-family-script); font-style: normal; font-size: 1.1em; }
  .page-hero-desc {
    color: rgba(255,255,255,0.6); font-size: 1.1rem; margin-top: 16px;
    max-width: 500px; font-weight: 300; position: relative; z-index: 1;
  }
  .journal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .journal-card { background: var(--color-surface); border-radius: var(--radius-lg); border: 1px solid var(--color-border); overflow: hidden; transition: transform 0.4s ease, box-shadow 0.4s ease; }
  .journal-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
  .journal-image { position: relative; overflow: hidden; aspect-ratio: 3/2; }
  .journal-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .journal-card:hover .journal-image img { transform: scale(1.05); }
  .journal-date { position: absolute; top: 16px; left: 16px; background: rgba(0,53,19,0.85); color: #fff; font-size: 0.75rem; font-weight: 600; padding: 6px 12px; border-radius: var(--radius-sm); letter-spacing: 0.05em; }
  .journal-body { padding: 24px; }
  .journal-tag { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 12px; }
  .journal-title { font-family: var(--font-family-display); font-size: 1.2rem; font-weight: 600; line-height: 1.3; margin-bottom: 12px; }
  .journal-excerpt { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 16px; }
  .journal-link { display: inline-flex; align-items: center; gap: 8px; font-size: 0.85rem; font-weight: 600; color: var(--color-primary); text-decoration: none; transition: gap 0.3s ease; }
  .journal-link:hover { gap: 12px; }
  @media (max-width: 1024px) { .journal-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 768px) { .journal-grid { grid-template-columns: 1fr; } }
</style>

