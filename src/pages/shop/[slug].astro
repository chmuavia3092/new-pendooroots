---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { products, getProductBySlug, getRelatedProducts, formatPrice } from '@/data/products';

export function getStaticPaths() {
  return products.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug!);
if (!product) return Astro.redirect('/shop');

const related = getRelatedProducts(product.id, 4);
---

<BaseLayout title={`${product.name} — PENDOOROOTS`} description={product.description}>
  <section class="product-detail">
    <div class="container">
      <div class="product-detail-grid">
        <div class="product-detail-image">
          <img src={product.image} alt={`${product.name} ${product.variant}`} width="400" height="500" />
          {product.badge && <span class="product-badge">{product.badge}</span>}
        </div>
        <div class="product-detail-info">
          <span class="product-detail-category">{product.collection}</span>
          <h1 class="product-detail-name">{product.name}</h1>
          <p class="product-detail-variant">{product.variant}</p>
          <div class="product-detail-rating">
            <span class="stars">{'★'.repeat(Math.round(product.rating))}{'☆'.repeat(5 - Math.round(product.rating))}</span>
            <span class="review-count">({product.reviews} reviews)</span>
          </div>
          <div class="product-detail-price">
            <span class="price-current">{formatPrice(product.price)}</span>
            {product.oldPrice && <span class="price-old">{formatPrice(product.oldPrice)}</span>}
          </div>
          <p class="product-detail-desc">{product.description}</p>
          <div class="product-detail-ingredients">
            <h3>Ingredients</h3>
            <ul>
              {product.ingredients.map(i => <li>{i}</li>)}
            </ul>
          </div>
          <div class="product-detail-benefits">
            <h3>Benefits</h3>
            <ul>
              {product.benefits.map(b => <li>{b}</li>)}
            </ul>
          </div>
          <div class="product-detail-howto">
            <h3>How to Use</h3>
            <p>{product.howToUse}</p>
          </div>
          <div class="product-detail-sizes">
            <h3>Available Sizes</h3>
            <div class="size-options">
              {product.sizes.map(s => <span class="size-option">{s}</span>)}
            </div>
          </div>
          <div class="product-detail-actions">
            <button class="cta-btn cta-btn--primary" data-add-to-cart={product.id} data-open-cart>
              <i class="fas fa-shopping-bag"></i> Add to Cart
            </button>
            <button class="cta-btn cta-btn--secondary" data-wishlist-toggle={product.id}>
              <i class="fas fa-heart"></i> Wishlist
            </button>
          </div>
          <div class="product-detail-stock">
            {product.stock > 0 ? (
              <span class="in-stock"><i class="fas fa-check-circle"></i> In Stock ({product.stock} available)</span>
            ) : (
              <span class="out-of-stock"><i class="fas fa-times-circle"></i> Out of Stock</span>
            )}
          </div>
        </div>
      </div>

      {related.length > 0 && (
        <div class="related-products">
          <h2 class="section-title">Related Products</h2>
          <div class="products-grid">
            {related.map((p) => (
              <a href={`/shop/${p.slug}`} class="related-product-card">
                <div class="related-product-card-image">
                  <img src={p.image} alt={`${p.name} ${p.variant}`} width="400" height="500" loading="lazy" decoding="async" />
                </div>
                <h3 class="related-product-card-name">{p.name}</h3>
                <p class="related-product-card-price">{formatPrice(p.price)}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .product-detail { padding: 60px 0; }
  .product-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .product-detail-image { position: relative; }
  .product-detail-image img { width: 100%; height: auto; object-fit: contain; }
  .product-detail-info { display: flex; flex-direction: column; gap: 16px; }
  .product-detail-category { text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.1em; color: #4caf50; font-weight: 600; }
  .product-detail-name { font-size: 2rem; font-weight: 700; color: #004b1c; }
  .product-detail-variant { font-size: 1.1rem; color: #666; }
  .product-detail-rating { display: flex; align-items: center; gap: 8px; }
  .product-detail-price { display: flex; align-items: center; gap: 12px; }
  .price-current { font-size: 1.5rem; font-weight: 700; color: #004b1c; }
  .price-old { font-size: 1.1rem; color: #999; text-decoration: line-through; }
  .product-detail-desc { line-height: 1.6; color: #444; }
  .product-detail-ingredients h3, .product-detail-benefits h3, .product-detail-howto h3, .product-detail-sizes h3 { font-size: 1rem; font-weight: 600; color: #004b1c; margin-bottom: 8px; }
  .product-detail-ingredients ul, .product-detail-benefits ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .product-detail-ingredients li, .product-detail-benefits li { background: #f0f5f1; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; }
  .product-detail-howto p { line-height: 1.6; color: #444; }
  .size-options { display: flex; gap: 8px; }
  .size-option { padding: 8px 16px; border: 1px solid #004b1c; border-radius: 8px; cursor: pointer; transition: all 0.2s; }
  .size-option:hover { background: #004b1c; color: #fff; }
  .product-detail-actions { display: flex; gap: 12px; margin-top: 16px; }
  .product-detail-stock { margin-top: 8px; }
  .in-stock { color: #4caf50; }
  .out-of-stock { color: #ef4444; }
  /* ── Related Products ── */
  .related-products { margin-top: 60px; }
  .related-products .section-title { text-align: center; margin-bottom: 32px; }
  .related-products .products-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-top: 24px;
  }
  .related-product-card {
    flex: 0 1 calc(33.333% - 16px); /* 3 per row */
    max-width: 320px; /* never excessively wide */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }
  .related-product-card-image {
    width: 100%;
    aspect-ratio: 4 / 5; /* consistent portrait container */
    background: #f6faf7; /* soft botanical tint */
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 8px;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  }
  .related-product-card:hover .related-product-card-image {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 75, 28, 0.12);
  }
  .related-product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain; /* preserve original proportions — never crop/stretch */
    padding: 10%; /* product prominent, not touching edges */
    transition: transform 0.35s ease;
  }
  .related-product-card:hover .related-product-card-image img { transform: scale(1.04); }
  .related-product-card-name {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }
  .related-product-card-price {
    font-size: 1.05rem;
    font-weight: 700;
    color: #004b1c; /* botanical green brand emphasis */
    margin: 2px 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .related-product-card-image,
    .related-product-card-image img { transition: none; }
    .related-product-card:hover .related-product-card-image,
    .related-product-card:hover .related-product-card-image img { transform: none; }
  }

  .cta-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1rem;
    color: #fff;
    background: #004b1c;
    border: none;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease;
  }
  .cta-btn--secondary {
    background: #002e11;
  }
  .cta-btn:hover {
    transform: scale(1.03);
    box-shadow: 0 0 18px rgba(204, 255, 0, 0.4);
  }
  .cta-btn:active { transform: scale(0.97); }

  @media (max-width: 992px) {
    .related-product-card { flex: 0 1 calc(50% - 12px); } /* tablet: 2 per row */
  }
  @media (max-width: 768px) {
    .product-detail-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .related-products .products-grid { gap: 14px; }
    .related-product-card { flex: 0 1 calc(50% - 7px); }
    .related-product-card-name { font-size: 0.85rem; }
    .related-product-card-price { font-size: 0.95rem; }
  }
</style>
