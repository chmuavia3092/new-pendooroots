---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="About Us â€” PENDOOROOTS">
  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="container">
      <h1 class="page-hero-title">Our <span class="accent">Story</span></h1>
      <p class="page-hero-desc">Born from a belief that clean should mean truly clean.</p>
    </div>
  </section>

  <section class="section" data-navbar-theme="dark">`n    <div class="container">`n      <div class="about-grid">
        <div class="about-image reveal">
          <img src="/images/rose-face-wash.jpg" alt="Rose Brightening Face Wash" width="600" height="750" loading="lazy">
          <div class="about-image-accent"></div>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="about-tag"><i class="fas fa-leaf"></i> Our Story</div>
          <h2 class="about-title">Born from a belief that <em>clean</em> should mean <em>truly clean</em>.</h2>
          <p class="about-desc">PendooRoots started with one simple question: Why do "natural" products still contain chemicals we can't pronounce? We set out to create products with ingredients so pure, you could list them on a menu.</p>
          <p class="about-desc">Every product is a fusion of ancient botanical wisdom and modern science. We source from certified organic farms and never use synthetic chemicals, parabens, sulfates, or artificial fragrances.</p>
          <div class="about-stats">
            <div><div class="about-stat-value">2019</div><div class="about-stat-label">Founded</div></div>
            <div><div class="about-stat-value">4</div><div class="about-stat-label">Collections</div></div>
            <div><div class="about-stat-value">19</div><div class="about-stat-label">Products</div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--color-bg-alt);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-tag"><i class="fas fa-heart"></i> Values</div>
        <h2 class="section-title">What We <span class="accent">Stand For</span></h2>
      </div>
      <div class="values-grid">
        <div class="value-card reveal reveal-delay-1">
          <div class="value-icon"><i class="fas fa-leaf"></i></div>
          <h3>100% Natural</h3>
          <p>Every ingredient is sourced from certified organic farms.</p>
        </div>
        <div class="value-card reveal reveal-delay-2">
          <div class="value-icon"><i class="fas fa-recycle"></i></div>
          <h3>Eco Packaging</h3>
          <p>Recyclable materials, zero waste commitment.</p>
        </div>
        <div class="value-card reveal reveal-delay-3">
          <div class="value-icon"><i class="fas fa-heart"></i></div>
          <h3>Cruelty Free</h3>
          <p>Never tested on animals, never.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 160px 0 80px; position: relative; overflow: hidden;
    background: linear-gradient(135deg, #003513 0%, #004b1c 40%, #006b2a 70%, #1a8a4a 100%);
  }
  .page-hero-bg {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 50% at 20% 80%, rgba(204,255,0,0.12) 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 80% 20%, rgba(204,255,0,0.08) 0%, transparent 50%);
  }
  .page-hero-title {
    font-family: var(--font-family-script); font-size: clamp(2.5rem, 5vw, 4rem);
    color: #fff; font-weight: 400; line-height: 1.2; position: relative; z-index: 1;
  }
  .page-hero-title .accent { color: var(--color-accent); font-family: var(--font-family-script); font-style: normal; font-size: 1.1em; }
  .page-hero-desc {
    color: rgba(255,255,255,0.6); font-size: 1.1rem; margin-top: 16px;
    max-width: 500px; font-weight: 300; position: relative; z-index: 1;
  }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .about-image { position: relative; border-radius: var(--radius-xl); overflow: hidden; }
  .about-image img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .about-image-accent { position: absolute; bottom: -20px; right: -20px; width: 200px; height: 200px; background: var(--color-accent); border-radius: var(--radius-xl); z-index: -1; opacity: 0.3; }
  .about-tag { display: inline-flex; align-items: center; gap: 8px; font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 16px; }
  .about-title { font-family: var(--font-family-script); font-weight: 400; font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1.2; margin-bottom: 20px; }
  .about-desc { color: var(--color-text-secondary); line-height: 1.8; margin-bottom: 24px; font-weight: 300; }
  .about-stats { display: flex; gap: 40px; margin-top: 32px; }
  .about-stat-value { font-size: 2.5rem; font-weight: 800; color: var(--color-primary); }
  .about-stat-label { font-size: var(--text-sm); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .value-card { padding: 40px 32px; background: var(--color-surface); border-radius: var(--radius-lg); border: 1px solid var(--color-border); text-align: center; transition: transform 0.4s ease, box-shadow 0.4s ease; }
  .value-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
  .value-icon { font-size: 2rem; margin-bottom: 16px; color: var(--color-primary); }
  .value-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; }
  .value-card p { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.6; }
  @media (max-width: 1024px) { .about-grid { grid-template-columns: 1fr; gap: 40px; } .values-grid { grid-template-columns: 1fr; } }
</style>


