---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/hero/Hero.astro';
import ProductCard from '@/components/product/ProductCard.astro';
import BorderBeam from '@/components/ui/BorderBeam.astro';
import { products, getBestSellers, getFeaturedProducts, getProductsByCollection } from '@/data/products';
import { heroContent, featuresContent, testimonialsContent, collectionsContent } from '@/data/content';
---

<BaseLayout title="LEMOO Washer by PENDOOROOTS — Make Every Dish Shine">
  <Hero content={heroContent} />

  <!-- Why PendooRoots -->
  <!-- Why PendooRoots -->
  <section class="section section-gradient-1">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-tag"><i class="fas fa-star"></i> Why PendooRoots</div>
        <h2 class="section-title">Engineered for <span class="accent">Purity</span></h2>
        <p class="section-desc">Every product is a fusion of ancient botanical wisdom and modern science.</p>
      </div>
      <div class="features-grid">
        {featuresContent.map((f, i) => (
          <div class="feature-card reveal reveal-delay-{i+1}">
            <div class="feature-icon"><i class="fas {f.icon}"></i></div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Best Sellers -->
  <section class="section section-gradient-2" style="background: linear-gradient(180deg, #f0f5f1 0%, #e8f0e9 50%, #f0f5f1 100%);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-tag"><i class="fas fa-fire"></i> Best Sellers</div>
        <h2 class="section-title">Most <span class="accent">Loved</span> Products</h2>
        <p class="section-desc">Discover what thousands of customers can't stop talking about.</p>
      </div>
      <div class="products-grid">
        {getBestSellers().map((p, i) => (
          <ProductCard product={p} index={i} />
        ))}
      </div>
      <div style="text-align:center; margin-top:48px;" class="reveal">
        <a href="/shop" class="btn btn-primary btn-lg"
           data-border-glow
           data-glow-color="120 100 50"
           data-background-color="#004b1c"
           data-border-radius="999"
           data-glow-radius="30"
           data-glow-intensity="1"
           data-cone-spread="25"
           data-colors="#ccff00,#4caf50,#2e7d32">
          View All Products <i class="fas fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Collections -->
  <section class="section section-gradient-3" style="background: linear-gradient(180deg, #ffffff 0%, #f5f8f6 50%, #ffffff 100%);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-tag"><i class="fas fa-th-large"></i> Collections</div>
        <h2 class="section-title">Explore by <span class="accent">Category</span></h2>
        <p class="section-desc">Curated collections for every aspect of your daily ritual.</p>
      </div>
      <div class="categories-grid">
        {Object.entries(collectionsContent).map(([key, col], i) => {
          const count = getProductsByCollection(key as any).length;
          const img = getProductsByCollection(key as any)[0]?.image || '';
          return (
            <a href="/shop" class={`category-card reveal reveal-delay-${i+1}`}>
              <div class="category-card-bg" style={`background-image:url('${img}')`}></div>
              <div class="category-card-overlay"></div>
              <div class="category-card-content">
                <div class="category-card-count">{count} Products</div>
                <h3 class="category-card-name">{col.icon} {col.name}</h3>
                <span class="category-card-link">Explore <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="section section-gradient-4" style="background: linear-gradient(180deg, #f0f5f1 0%, #e5ede7 50%, #f0f5f1 100%);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-tag"><i class="fas fa-th-large"></i> Featured</div>
        <h2 class="section-title">Our <span class="accent">Premium</span> Range</h2>
        <p class="section-desc">Handpicked products that define luxury botanical care.</p>
      </div>
      <div class="products-grid">
        {getFeaturedProducts().map((p, i) => (
          <ProductCard product={p} index={i} />
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section testimonials-section" style="background: linear-gradient(180deg, #ffffff 0%, #f5f8f6 50%, #ffffff 100%);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-tag"><i class="fas fa-quote-left"></i> Testimonials</div>
        <h2 class="section-title">What Our <span class="accent">Community</span> Says</h2>
      </div>
      <div style="overflow:hidden;">
        <div class="testimonial-track" id="testimonialTrack">
          {testimonialsContent.map(t => (
            <div class="testimonial-card">
              <div class="testimonial-stars" set:html={'<i class="fas fa-star"></i>'.repeat(t.rating)} />
              <p class="testimonial-text">"{t.text}"</p>
              <div class="testimonial-author">
                <img class="testimonial-avatar" src={t.avatar} alt={t.name} width="56" height="56" loading="lazy" />
                <div>
                  <div class="testimonial-name">{t.name}</div>
                  <div class="testimonial-role">Verified Customer</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-image reveal">
          <img src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?w=700" alt="PendooRoots natural botanical products" width="700" height="875" loading="lazy">
          <div class="about-image-accent"></div>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="about-tag"><i class="fas fa-leaf"></i> Our Story</div>
          <h2 class="about-title">Born from a belief that <em>clean</em> should mean <em>truly clean</em>.</h2>
          <p class="about-desc">PendooRoots started with one simple question: Why do "natural" products still contain chemicals we can't pronounce? We set out to create products with ingredients so pure, you could list them on a menu.</p>
          <div class="about-stats">
            <div>
              <div class="about-stat-value" data-count="2019">0</div>
              <div class="about-stat-label">Founded</div>
            </div>
            <div>
              <div class="about-stat-value" data-count="4">0</div>
              <div class="about-stat-label">Collections</div>
            </div>
            <div>
              <div class="about-stat-value" data-count={getFeaturedProducts().length}>0</div>
              <div class="about-stat-label">Products</div>
            </div>
          </div>
          <a href="/about" class="btn btn-primary"
             data-border-glow
             data-glow-color="120 100 50"
             data-background-color="#004b1c"
             data-border-radius="999"
             data-glow-radius="30"
             data-glow-intensity="1"
             data-cone-spread="25"
             data-colors="#ccff00,#4caf50,#2e7d32">Read Our Story <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="newsletter-section">
    <BorderBeam duration={8} size={150} colorFrom="#ccff00" colorTo="#4caf50">
      <div class="newsletter-inner reveal">
        <h2 class="newsletter-title">Join the <em>PendooRoots</em> Family</h2>
        <p class="newsletter-desc">Subscribe for exclusive offers, skincare tips, and early access to new collections.</p>
        <form class="newsletter-form" onsubmit="event.preventDefault(); showToast('Welcome to the PendooRoots family!', 'success'); this.reset();">
          <label class="sr-only" for="nl_email">Email address</label>
          <input id="nl_email" name="email" type="email" placeholder="Enter your email…" autocomplete="email" required />
          <button type="submit"
             data-border-glow
             data-glow-color="120 100 50"
             data-background-color="#ccff00"
             data-border-radius="999"
             data-glow-radius="25"
             data-glow-intensity="1"
             data-cone-spread="25"
             data-colors="#ccff00,#4caf50,#2e7d32">Subscribe</button>
        </form>
      </div>
    </BorderBeam>
  </section>
</BaseLayout>

<style>
  /* Gradient Sections */
  .section-gradient-1 {
    background: linear-gradient(180deg, #ffffff 0%, #f5f8f6 30%, #eef3ef 60%, #f5f8f6 100%);
    position: relative;
  }
  .section-gradient-1::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,75,28,0.08), transparent);
  }

  /* Feature Cards */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .feature-card {
    padding: 40px 28px;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    text-align: center;
    border: 1px solid var(--color-border);
    transition: var(--transition-base);
  }

  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: transparent;
  }

  .feature-icon {
    width: 64px;
    height: 64px;
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    font-size: 1.4rem;
    color: var(--color-primary);
    transition: var(--transition-base);
  }

  .feature-card:hover .feature-icon {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .feature-title {
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    margin-bottom: 8px;
  }

  .feature-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Categories Grid */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .category-card {
    position: relative;
    height: 360px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
    background: var(--color-primary-dark);
    display: block;
  }

  .category-card-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.8s var(--ease-out-expo);
  }

  .category-card:hover .category-card-bg {
    transform: scale(1.08);
  }

  .category-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.7) 100%);
  }

  .category-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px;
    color: #fff;
    z-index: 2;
  }

  .category-card-count {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .category-card-name {
    font-family: var(--font-family-display);
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 12px;
  }

  .category-card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: rgba(255,255,255,0.8);
    transition: var(--transition-fast);
  }

  .category-card-link:hover {
    color: var(--color-accent);
    gap: 12px;
  }

  /* About Grid */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .about-image {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .about-image img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
  }

  .about-image-accent {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 200px;
    height: 200px;
    background: var(--color-accent);
    border-radius: var(--radius-xl);
    z-index: -1;
    opacity: 0.3;
  }

  .about-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest-plus);
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .about-title {
    font-family: var(--font-family-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 20px;
  }

  .about-desc {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 32px;
    font-weight: var(--font-weight-light);
  }

  .about-stats {
    display: flex;
    gap: 40px;
    margin-bottom: 32px;
  }

  .about-stat-value {
    font-size: 2.5rem;
    font-weight: var(--font-weight-extrabold);
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  .about-stat-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  /* Testimonials */
  .testimonials-section {
    background: var(--color-bg-alt);
  }

  .testimonial-track {
    display: flex;
    gap: 24px;
    overflow: hidden;
    padding: 20px 0;
  }

  .testimonial-card {
    min-width: 380px;
    padding: 36px;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
    transition: var(--transition-base);
  }

  .testimonial-card:hover {
    box-shadow: var(--shadow-md);
  }

  .testimonial-stars {
    color: var(--color-star);
    font-size: var(--text-sm);
    margin-bottom: 16px;
  }

  .testimonial-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 24px;
    font-style: italic;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonial-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #ccff00;
    flex-shrink: 0;
    background: var(--color-primary-dark);
  }

  .testimonial-name {
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-base);
  }

  .testimonial-role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Newsletter */
  .newsletter-section {
    background: var(--color-primary-dark);
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }

  .newsletter-inner {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .newsletter-title {
    font-family: var(--font-family-script);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 400;
    color: #fff;
    margin-bottom: 16px;
  }

  .newsletter-desc {
    color: rgba(255,255,255,0.6);
    margin-bottom: 32px;
    font-weight: var(--font-weight-light);
  }

  .newsletter-form {
    display: flex;
    gap: 12px;
    max-width: 480px;
    margin: 0 auto;
  }

  .newsletter-form input {
    flex: 1;
    padding: 16px 24px;
    border-radius: var(--radius-full);
    border: 1.5px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.05);
    color: #fff;
    font-size: var(--text-base);
    outline: none;
    transition: var(--transition-base);
  }

  .newsletter-form input::placeholder {
    color: rgba(255,255,255,0.4);
  }

  .newsletter-form input:focus {
    border-color: var(--color-accent);
  }

  .newsletter-form button {
    padding: 16px 32px;
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    border: none;
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-base);
    transition: var(--transition-base);
    cursor: pointer;
  }

  .newsletter-form button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(204,255,0,0.3);
  }

  .newsletter-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(204,255,0,0.08) 0%, transparent 70%);
    filter: blur(80px);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
    .categories-grid { grid-template-columns: repeat(2, 1fr); }
    .about-grid { grid-template-columns: 1fr; gap: 40px; }
    .about-image { max-width: 500px; margin: 0 auto; }
    .about-stats { justify-content: center; }
    .testimonial-card { min-width: 320px; }
  }

  @media (max-width: 768px) {
    .features-grid { grid-template-columns: 1fr; }
    .categories-grid { grid-template-columns: 1fr; }
    .about-stats { flex-wrap: wrap; gap: 24px; justify-content: center; }
    .about-stat-value { font-size: 2rem; }
    .testimonial-track { padding: 16px 0; }
    .testimonial-card { min-width: 280px; padding: 24px; }
    .newsletter-form { flex-direction: column; }
    .newsletter-form button { width: 100%; }
  }
</style>