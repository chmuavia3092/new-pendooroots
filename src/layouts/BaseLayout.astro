---
import '@/styles/global.css';
import '@/styles/components.css';
import '@/styles/border-glow.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  canonical?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'LEMOO Washer by PENDOOROOTS — Premium natural dish wash. Grease lifter, skin friendly, perfect shine. 100% botanical ingredients.',
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  canonical,
  noIndex = false,
} = Astro.props;

const siteUrl = 'https://pendooroots-site.vercel.app';
const canonicalUrl = canonical || Astro.url.pathname;
const fullOgImage = new URL(ogImage, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="LEMOO washer, dish wash, natural cleaning, lemon dish wash, grease lifter, PENDOOROOTS, premium dish wash, botanical products">
  <meta name="theme-color" content="#004b1c" id="themeColorMeta">

  {noIndex && <meta name="robots" content="noindex, nofollow">}

  <link rel="canonical" href={new URL(canonicalUrl, siteUrl).href}>

  <!-- Open Graph -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={new URL(canonicalUrl, siteUrl).href}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={fullOgImage}>
  <meta property="og:site_name" content="PENDOOROOTS">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={new URL(canonicalUrl, siteUrl).href}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={fullOgImage}>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'PENDOOROOTS',
    url: siteUrl,
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/shop?q={search_term_string}` },
      'query-input': 'required name=search_term_string'
    }
  })} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Imperial+Script&family=Manrope:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌿</text></svg>">

  <!-- Preload critical assets -->
  <link rel="preload" as="image" href="/images/lemoo-washer.png" fetchpriority="high">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <!-- PRELOADER (CSS-only, no JS dependency) -->
  <div id="preloader" role="status" aria-label="Loading">
    <div class="preloader-inner">
      <div class="preloader-logo" style="font-family:'Imperial Script',cursive;letter-spacing:0.08em;">PENDOOROOTS</div>
      <div class="preloader-bar"><div class="preloader-fill"></div></div>
      <div class="preloader-text">Nature Perfected</div>
    </div>
  </div>
  <style>
    #preloader {
      position: fixed; inset: 0; z-index: 10000;
      background: #003513;
      display: flex; align-items: center; justify-content: center;
      animation: preloaderHide 0.6s ease 2.8s forwards;
    }
    .preloader-logo {
      font-family: 'Manrope', system-ui, sans-serif;
      font-size: 2.5rem; font-weight: 800;
      color: #ccff00; letter-spacing: 0.3em;
      margin-bottom: 32px;
      opacity: 0; animation: preloaderFadeIn 0.8s 0.2s forwards;
    }
    .preloader-bar {
      width: 200px; height: 2px;
      background: rgba(255,255,255,0.1);
      margin: 0 auto 16px; border-radius: 2px; overflow: hidden;
    }
    .preloader-fill {
      width: 0; height: 100%;
      background: #ccff00;
      animation: preloaderFill 2s 0.4s ease-in-out forwards;
    }
    .preloader-text {
      font-size: 0.85rem; color: rgba(255,255,255,0.5);
      letter-spacing: 0.2em; text-transform: uppercase;
      opacity: 0; animation: preloaderFadeIn 0.8s 0.6s forwards;
    }
    @keyframes preloaderFadeIn { to { opacity: 1; } }
    @keyframes preloaderFill { to { width: 100%; } }
    @keyframes preloaderHide {
      to { opacity: 0; visibility: hidden; pointer-events: none; }
    }
  </style>

  <!-- CURSOR (desktop only) -->
  <div id="cursor" class="custom-cursor" aria-hidden="true"></div>
  <div id="cursor-follower" class="custom-cursor-follower" aria-hidden="true"></div>

  <!-- NAVIGATION -->
  <header id="navbar" class="navbar" role="banner">
    <div class="nav-inner">
      <a href="/" class="nav-logo" aria-label="PENDOOROOTS Home">
        <span class="logo-mark">P</span>
        <span class="logo-text" id="navBrand">PENDOOROOTS</span>
      </a>
      <nav class="nav-links" id="navLinks" role="navigation" aria-label="Main navigation">
        <a href="/" data-page="home" class="nav-link">Home</a>
        <a href="/shop" data-page="products" class="nav-link">Shop</a>
        <a href="/about" data-page="about" class="nav-link">About</a>
        <a href="/sustainability" data-page="sustainability" class="nav-link">Sustainability</a>
        <a href="/journal" data-page="blog" class="nav-link">Journal</a>
        <a href="/contact" data-page="contact" class="nav-link">Contact</a>
      </nav>
      <div class="nav-actions">
        <button class="nav-icon-btn" id="themeToggle" title="Toggle theme" aria-label="Toggle dark or light theme">
          <i class="fas fa-moon" aria-hidden="true"></i>
        </button>
        <button class="nav-icon-btn" id="searchToggle" title="Search" aria-label="Open search">
          <i class="fas fa-search" aria-hidden="true"></i>
        </button>
        <button class="nav-icon-btn" id="wishlistToggle" title="Wishlist" aria-label="View wishlist">
          <i class="fas fa-heart" aria-hidden="true"></i>
          <span class="badge" id="wishlistBadge">0</span>
        </button>
        <button class="nav-icon-btn" id="cartToggle" title="Cart" aria-label="Open shopping bag">
          <i class="fas fa-shopping-bag" aria-hidden="true"></i>
          <span class="badge" id="cartBadge">0</span>
        </button>
      </div>
      <button class="hamburger" id="hamburger" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobileMenu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </header>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Mobile navigation">
    <div class="mobile-menu-inner">
      <a href="/" data-page="home" class="mobile-link">Home</a>
      <a href="/shop" data-page="products" class="mobile-link">Shop</a>
      <a href="/about" data-page="about" class="mobile-link">About</a>
      <a href="/sustainability" data-page="sustainability" class="mobile-link">Sustainability</a>
      <a href="/journal" data-page="blog" class="mobile-link">Journal</a>
      <a href="/contact" data-page="contact" class="mobile-link">Contact</a>
    </div>
  </div>

  <!-- SEARCH OVERLAY -->
  <div class="search-overlay" id="searchOverlay" role="dialog" aria-modal="true" aria-label="Search products">
    <div class="search-overlay-inner">
      <label class="sr-only" for="searchInput">Search products, ingredients, benefits</label>
      <input type="text" id="searchInput" name="search" placeholder="Search products, ingredients, benefits…" autocomplete="off" spellcheck="false" enterkeyhint="search">
      <button class="search-close" id="searchClose" aria-label="Close search"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="search-results" id="searchResults"></div>
  </div>

  <!-- MAIN CONTENT -->
  <main id="main-content"><slot /></main>

  <!-- CART SIDEBAR -->
  <div class="cart-overlay" id="cartOverlay" aria-hidden="true"></div>
  <aside class="cart-sidebar" id="cartSidebar" role="dialog" aria-modal="true" aria-label="Shopping bag">
    <div class="cart-header">
      <h3>Your Bag</h3>
      <button class="cart-close" id="cartClose" aria-label="Close shopping bag"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="cart-items" id="cartItems"></div>
    <div class="cart-footer" id="cartFooter">
      <div class="cart-subtotal">
        <span>Subtotal</span>
        <span id="cartSubtotal">Rs.0</span>
      </div>
      <div class="cart-shipping">
        <span>Shipping</span>
        <span id="cartShipping">Calculated at checkout</span>
      </div>
      <a href="/checkout" class="btn btn-primary btn-full cart-checkout-btn"
         data-border-glow
         data-glow-color="120 100 50"
         data-background-color="#004b1c"
         data-border-radius="999"
         data-glow-radius="25"
         data-glow-intensity="1"
         data-cone-spread="25"
         data-colors="#ccff00,#4caf50,#2e7d32">Proceed to Checkout</a>
      <a href="/shop" class="btn btn-ghost btn-full">Continue Shopping</a>
    </div>
  </aside>

  <!-- TOAST -->
  <div class="toast-container" id="toastContainer" role="status" aria-live="polite"></div>

  <!-- WHATSAPP FLOAT -->
  <div class="whatsapp-beam">
    <a href="https://wa.me/923474736347?text=Hi%20PendooRoots!%20I'm%20interested%20in%20your%20products."
       target="_blank" rel="noopener" class="whatsapp-float" id="whatsappFloat" title="Chat on WhatsApp" aria-label="Chat with us on WhatsApp">
      <i class="fab fa-whatsapp" aria-hidden="true"></i>
      <span class="whatsapp-tooltip">Chat with us!</span>
    </a>
  </div>

  <!-- FOOTER -->
  <footer id="siteFooter" class="footer" role="contentinfo">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="nav-logo" aria-label="PENDOOROOTS Home">
            <span class="logo-mark">P</span>
            <span class="logo-text">PENDOOROOTS</span>
          </a>
          <p class="footer-brand-desc">Premium botanical household care. Natural ingredients, luxurious experience, conscious living.</p>
          <div class="footer-social">
            <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
          </div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Shop</div>
          <a href="/shop" class="footer-link">All Products</a>
          <a href="/shop" class="footer-link">Kitchen Care</a>
          <a href="/shop" class="footer-link">Rose Collection</a>
          <a href="/shop" class="footer-link">Aloe Vera</a>
          <a href="/shop" class="footer-link">Premium</a>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Company</div>
          <a href="/about" class="footer-link">About Us</a>
          <a href="/sustainability" class="footer-link">Sustainability</a>
          <a href="/journal" class="footer-link">Journal</a>
          <a href="/contact" class="footer-link">Contact</a>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Support</div>
          <a href="/faq" class="footer-link">FAQ</a>
          <a href="/privacy" class="footer-link">Privacy Policy</a>
          <a href="/terms" class="footer-link">Terms of Service</a>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Contact</div>
          <div class="footer-contact-item">
            <i class="fas fa-envelope" aria-hidden="true"></i>
            <span>ibmilyas347@gmail.com</span>
          </div>
          <div class="footer-contact-item">
            <i class="fas fa-phone" aria-hidden="true"></i>
            <span>0313-5442427</span>
          </div>
          <div class="footer-contact-item">
            <i class="fab fa-whatsapp" aria-hidden="true"></i>
            <span>03474736347</span>
          </div>
          <div class="footer-contact-item">
            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
            <span>42 Botanical Lane, Garden District, Karachi</span>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; 2024 PENDOOROOTS. All rights reserved.</span>
        <span>Crafted with care in Pakistan.</span>
      </div>
    </div>
  </footer>

  <!-- PAGE SCRIPTS -->
  <script type="module" src="/src/scripts/main.ts"></script>
  <script is:inline src="/scripts/border-glow.js"></script>
</body>
</html>